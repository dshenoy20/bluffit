rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MVP rules: any anonymously-authenticated player can read/write game data.
    // Game integrity is enforced by transactional client logic; tighten these
    // before adding anything beyond the party-game MVP.

    match /rooms/{roomCode} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }

      match /submissions/{subId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false; // answers can't be edited after submitting
      }

      match /votes/{voteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false; // one vote, no changes
      }
    }

    match /stats/global {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
